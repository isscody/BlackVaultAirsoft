generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── REPLICHE ASG ──────────────────────────────────────────────

model Firearm {
  id              String   @id @default(cuid())
  name            String
  manufacturer    String
  model           String
  // bbWeight: "0.20g" | "0.25g" | "0.28g" | "0.30g" | "0.32g" | "0.36g" | "0.40g" | "0.43g" | "0.45g"
  caliber             String
  compatibleCalibers  String?
  serialNumber    String   @unique
  // type: AEG | AEP | GBB_PISTOLA | GBB_FUCILE | HPA | NGRS | GAS_NBB | SPRINGER | DMRSNIPER
  type            String
  acquisitionDate DateTime
  purchasePrice   Float?
  currentValue    Float?
  notes           String?
  imageUrl        String?
  // imageSource: "uploaded" | "google_cse" | "seed" | "url"
  imageSource     String?

  // Manutenzione replica
  lastMaintenanceDate     DateTime?
  maintenanceIntervalDays Int?

  builds          Build[]
  rangeSessions   RangeSession[]
  documents       Document[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([caliber])
  @@index([type])
}

// ─── LOADOUT / BUILD ──────────────────────────────────────────

model Build {
  id          String      @id @default(cuid())
  name        String
  description String?
  isActive    Boolean     @default(false)
  sortOrder   Int         @default(0)
  firearmId   String
  firearm     Firearm     @relation(fields: [firearmId], references: [id], onDelete: Cascade)

  slots       BuildSlot[]
  rangeSessions RangeSession[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([firearmId])
  @@index([isActive])
}

model BuildSlot {
  id          String     @id @default(cuid())
  buildId     String
  build       Build      @relation(fields: [buildId], references: [id], onDelete: Cascade)
  // SlotType: CANNA | HOP_UP | SILENZIATORE | CALCIO | IMPUGNATURA | OTTICA | MOUNT_OTTICA |
  //           TORCIA | LASER | BIPOD | TRACOLLA | CARICATORE | GRILLETTO | MOSFET |
  //           BATTERIA | REGOLATORE_HPA | TUBO_HPA | GEARBOX | MOTORE | COMPENSATORE
  slotType    String
  accessoryId String?
  accessory   Accessory? @relation(fields: [accessoryId], references: [id], onDelete: SetNull)

  // Posizione sul canvas della replica (percentuale 0-100)
  positionX   Float?
  positionY   Float?
  scaleX      Float?     @default(1.0)
  scaleY      Float?     @default(1.0)
  layerIndex  Int?       @default(0)

  @@unique([buildId, slotType])
  @@index([buildId])
  @@index([accessoryId])
}

// ─── ACCESSORI ────────────────────────────────────────────────

model Accessory {
  id                     String          @id @default(cuid())
  name                   String
  manufacturer           String
  model                  String?
  serialNumber           String?
  // type corrisponde ai valori SlotType sopra
  type                   String
  caliber                String?
  purchasePrice          Float?
  acquisitionDate        DateTime?
  notes                  String?
  imageUrl               String?
  imageSource            String?

  // Contatore BBS sparate — persiste attraverso tutti i loadout
  roundCount             Int             @default(0)
  roundCountLogs         RoundCountLog[]

  buildSlots             BuildSlot[]
  documents              Document[]

  // Tipi di replica compatibili, separati da virgola, es. "AEG,HPA"
  compatibleFirearmTypes String?
  // Grammature BBS compatibili, es. "0.20g,0.25g,0.28g"
  compatibleCalibers     String?

  // Tracciamento batteria (per AEG/AEP)
  hasBattery             Boolean         @default(false)
  // batteryType: "LiPo 7.4V" | "LiPo 11.1V" | "NiMH 8.4V" | "NiMH 9.6V" | "Li-Ion" | "Altra"
  batteryType            String?
  lastBatteryChangeDate  DateTime?
  replacementIntervalDays Int?

  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([type])
  @@index([roundCount])
}

model Document {
  id          String     @id @default(cuid())
  name        String
  type        String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  notes       String?
  firearmId   String?
  accessoryId String?
  firearm     Firearm?   @relation(fields: [firearmId], references: [id], onDelete: SetNull)
  accessory   Accessory? @relation(fields: [accessoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([firearmId])
  @@index([accessoryId])
  @@index([type])
  @@index([createdAt])
}

model RoundCountLog {
  id            String    @id @default(cuid())
  accessoryId   String
  accessory     Accessory @relation(fields: [accessoryId], references: [id], onDelete: Cascade)
  roundsAdded   Int
  previousCount Int
  newCount      Int
  sessionNote   String?
  loggedAt      DateTime  @default(now())

  @@index([accessoryId])
  @@index([loggedAt])
}

// ─── STOCK BBS ────────────────────────────────────────────────

model AmmoStock {
  id              String            @id @default(cuid())
  // bbWeight: "0.20g" | "0.25g" | "0.28g" | "0.30g" | "0.32g" | "0.36g" | "0.40g" | "0.43g" | "0.45g"
  caliber         String
  brand           String
  grainWeight     Float?
  // bbType: "Standard" | "Bio" | "Tracciante" | "Bio Tracciante"
  bulletType      String?
  quantity        Int               @default(0)
  purchasePrice   Float?
  // pricePerBB calcolato automaticamente
  pricePerRound   Float?
  purchaseDate    DateTime?
  storageLocation String?
  lowStockAlert   Int?
  notes           String?

  transactions    AmmoTransaction[]
  rangeSessionLinks RangeSessionAmmoLink[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([caliber])
}

// ─── SESSIONI DI GIOCO / FIELD ────────────────────────────────

model RangeSession {
  id            String                 @id @default(cuid())
  sessionDate   DateTime
  // location: nome del campo o area di gioco
  location      String
  firearmId     String
  firearm       Firearm                @relation(fields: [firearmId], references: [id], onDelete: Cascade)
  buildId       String?
  build         Build?                 @relation(fields: [buildId], references: [id], onDelete: SetNull)
  // roundsFired: numero di BBS sparate nella sessione
  roundsFired   Int
  notes         String?

  ammoLinks     RangeSessionAmmoLink[]
  sessionDrills SessionDrill[]

  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([sessionDate])
  @@index([firearmId])
  @@index([buildId])
}

model RangeSessionAmmoLink {
  id             String       @id @default(cuid())
  rangeSessionId String
  rangeSession   RangeSession @relation(fields: [rangeSessionId], references: [id], onDelete: Cascade)
  ammoStockId    String
  ammoStock      AmmoStock    @relation(fields: [ammoStockId], references: [id], onDelete: Cascade)
  // roundsUsed: BBS consumate in questa sessione
  roundsUsed     Int
  createdAt      DateTime     @default(now())

  @@unique([rangeSessionId, ammoStockId])
  @@index([rangeSessionId])
  @@index([ammoStockId])
}

model SessionDrill {
  id             String       @id @default(cuid())
  rangeSessionId String
  rangeSession   RangeSession @relation(fields: [rangeSessionId], references: [id], onDelete: Cascade)
  name           String
  setNumber      Int          @default(1)
  timeSeconds    Float?
  points         Float?
  penalties      Float?
  hits           Int?
  hitFactor      Float
  notes          String?
  sortOrder      Int          @default(0)
  drillDate      DateTime?
  createdAt      DateTime     @default(now())

  @@index([rangeSessionId])
}

model AmmoTransaction {
  id           String    @id @default(cuid())
  stockId      String
  stock        AmmoStock @relation(fields: [stockId], references: [id], onDelete: Cascade)
  // type: ACQUISTO | USO_FIELD | TRASFERIMENTO | CORREZIONE_INVENTARIO | CONSUMATE
  type         String
  quantity     Int
  previousQty  Int
  newQty       Int
  note         String?
  transactedAt DateTime  @default(now())

  @@index([stockId])
  @@index([transactedAt])
}

// ─── CACHE IMMAGINI ───────────────────────────────────────────

model ImageCache {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  searchQuery String
  imageUrl    String
  // source: "google_cse" | "uploaded" | "seed" | "url"
  source      String
  isApproved  Boolean  @default(false)
  width       Int?
  height      Int?
  cachedAt    DateTime @default(now())

  @@index([entityType, entityId])
}

// ─── IMPOSTAZIONI APP ─────────────────────────────────────────

model AppSettings {
  id                      String   @id @default("singleton")
  googleCseApiKey         String?
  googleCseSearchEngineId String?
  enableImageSearch       Boolean  @default(false)
  includeUploadsInBackup  Boolean  @default(true)
  autoBackupEnabled       Boolean  @default(false)
  autoBackupCadence       String   @default("weekly")
  backupDestinationPath   String?
  manualLanHost           String?
  defaultCurrency         String   @default("EUR")
  appPassword             String?
  defaultAmmoAlertThreshold Int?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}
